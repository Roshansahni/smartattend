# Database
DATABASE_URL=postgresql+asyncpg://smartattend:password@localhost:5432/smartattend_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartattend_db
DB_USER=smartattend
DB_PASSWORD=password

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-must-be-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=SmartAttend
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# QR
QR_TOKEN_EXPIRE_SECONDS=30
QR_REFRESH_INTERVAL_SECONDS=25

# GPS
GPS_DEFAULT_RADIUS_METERS=100
GPS_ENABLED=True

# Email (optional — for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
